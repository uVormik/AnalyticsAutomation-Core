@page "/"
@using global::App.Web.Features.Upload.Configuration
@inject IUploadSiteConnectionFeatureGate UploadFeatureGate

<PageTitle>Home</PageTitle>

<div class="container py-4">
    <div class="mb-4">
        <h1 class="h3">Analytics Automation</h1>
        <p class="text-body-secondary mb-0">Web control plane for authenticated video upload checks and receipt confirmation.</p>
    </div>

    <section class="border rounded p-3">
        <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
            <div>
                <h2 class="h5 mb-1">Video upload</h2>
                <div class="text-body-secondary">Online-only baseline through the existing control plane and local site upload stub.</div>
            </div>

            @if (UploadFeatureGate.IsEnabled)
            {
                <a class="btn btn-primary" href="upload">Open upload</a>
            }
            else
            {
                <span class="badge text-bg-secondary">Disabled by feature flag</span>
            }
        </div>
    </section>
</div>
