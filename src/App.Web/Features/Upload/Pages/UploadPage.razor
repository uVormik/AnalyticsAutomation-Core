@page "/upload"
@using global::App.Web.Features.Upload.Configuration
@using global::App.Web.Features.Upload.ControlPlane
@using global::App.Web.Features.Upload.Models
@using global::App.Web.Features.Upload.Presentation
@using Microsoft.AspNetCore.Components.Forms
@inject IUploadSiteConnectionFeatureGate UploadFeatureGate

<PageTitle>Upload</PageTitle>

@if (!UploadFeatureGate.IsEnabled)
{
    <div class="container py-4">
        <h1 class="h3">Upload</h1>
        <div class="alert alert-warning mt-3" role="alert">
            <div class="fw-semibold">Upload UI baseline is disabled.</div>
            <div>The feature flag is off, so the route stays visible as a kill switch surface and no upload flow can start.</div>
        </div>
        <a class="btn btn-outline-secondary" href="">Back home</a>
    </div>
}
else
{
    <div class="container py-4">
        <div class="mb-4">
            <h1 class="h3">Upload</h1>
            <p class="text-body-secondary mb-0">Online control plane session, group selection, local site upload boundary, and receipt confirmation.</p>
        </div>

        <div class="alert alert-info" role="alert">
            Online connection is required. Video bytes stay out of App.Api; the site upload step uses the local stub boundary in this baseline.
        </div>

        <section class="@AlertClass(CurrentPhaseModel.Tone)" role="status" aria-live="polite">
            <div class="d-flex flex-column flex-md-row justify-content-between gap-2">
                <div>
                    <div class="fw-semibold">@CurrentPhaseModel.Label</div>
                    <div class="small text-body-secondary">@(_statusMessage ?? "Ready")</div>
                </div>
                <div class="small text-body-secondary">@CurrentPhaseModel.Phase</div>
            </div>
            <div class="progress mt-3" role="progressbar" aria-label="Upload flow progress" aria-valuenow="@CurrentPhaseModel.ProgressPercent" aria-valuemin="0" aria-valuemax="100">
                <div class="progress-bar" style="@($"width: {CurrentPhaseModel.ProgressPercent}%")"></div>
            </div>
        </section>

        <section class="border rounded p-3 mt-4">
            <div class="d-flex flex-column flex-lg-row align-items-lg-start justify-content-between gap-3">
                <div>
                    <h2 class="h5 mb-1">Control plane session</h2>
                    <div class="text-body-secondary">Sign in stores an in-memory session for this browser tab. Token values are hidden.</div>
                </div>

                @if (_sessionSummary is not null)
                {
                    <button type="button" class="btn btn-outline-secondary" @onclick="ClearControlPlaneSessionAsync" disabled="@IsBusy">
                        Clear session
                    </button>
                }
            </div>

            @if (_sessionSummary is null)
            {
                <EditForm Model="_signInForm" OnValidSubmit="SignInControlPlaneAsync" class="mt-3">
                    <div class="row g-3">
                        <div class="col-12 col-lg-5">
                            <label class="form-label" for="control-plane-login">Login</label>
                            <InputText id="control-plane-login" class="form-control" @bind-Value="_signInForm.Login" autocomplete="username" />
                        </div>

                        <div class="col-12 col-lg-5">
                            <label class="form-label" for="control-plane-password">Password</label>
                            <input id="control-plane-password" type="password" class="form-control" @bind="_signInForm.Password" autocomplete="current-password" />
                        </div>

                        <div class="col-12 col-lg-2 d-flex align-items-end">
                            <button type="submit" class="btn btn-primary w-100" disabled="@IsBusy">
                                @(_phase == UploadSiteConnectionPhase.SigningIn ? "Signing in..." : "Sign in")
                            </button>
                        </div>
                    </div>
                </EditForm>
            }
            else
            {
                <dl class="row mb-0 mt-3">
                    <dt class="col-12 col-md-4">User</dt>
                    <dd class="col-12 col-md-8">@(_sessionSummary.DisplayName ?? "Authenticated user")</dd>

                    <dt class="col-12 col-md-4">UserId</dt>
                    <dd class="col-12 col-md-8">@_sessionSummary.UserId</dd>

                    <dt class="col-12 col-md-4">Session credentials</dt>
                    <dd class="col-12 col-md-8">Available, values hidden</dd>
                </dl>
            }

            @if (!string.IsNullOrWhiteSpace(_controlPlaneErrorMessage))
            {
                <div class="alert alert-danger mt-3" role="alert">@_controlPlaneErrorMessage</div>
            }
        </section>

        <section class="border rounded p-3 mt-4">
            <div class="d-flex flex-column flex-lg-row align-items-lg-start justify-content-between gap-3">
                <div>
                    <h2 class="h5 mb-1">Group</h2>
                    <div class="text-body-secondary">Load the authenticated group tree and select one upload target.</div>
                </div>

                <button type="button" class="btn btn-outline-primary" @onclick="LoadGroupTreeNodesAsync" disabled="@(!CanLoadGroups)">
                    @(_phase == UploadSiteConnectionPhase.LoadingGroups ? "Loading..." : "Load groups")
                </button>
            </div>

            @if (_selectedGroupNode is not null)
            {
                <div class="alert alert-success mt-3" role="alert">
                    <div class="fw-semibold">Selected group</div>
                    <div>@(_selectedGroupNode.Name ?? _selectedGroupNode.Code ?? _selectedGroupNode.Id?.ToString())</div>
                    <div class="small">@_selectedGroupNode.Path</div>
                </div>
            }

            @if (_groupNodes.Count > 0)
            {
                <div class="table-responsive mt-3">
                    <table class="table table-sm align-middle">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Code</th>
                                <th>Path</th>
                                <th>Selectable</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var node in _groupNodes)
                            {
                                <tr>
                                    <td>@node.Name</td>
                                    <td>@node.Code</td>
                                    <td>@node.Path</td>
                                    <td>@(node.IsSelectable == true ? "Yes" : "No")</td>
                                    <td>
                                        <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(!CanSelectGroupNode(node))" @onclick="() => SelectGroupNode(node)">
                                            Select
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <section class="border rounded p-3 mt-4">
            <h2 class="h5 mb-1">Video file</h2>
            <div class="text-body-secondary mb-3">Choose one video file. The browser computes SHA-256 locally before the control plane call.</div>

            <InputFile OnChange="HandleVideoFileSelectedAsync" accept="video/*" disabled="@IsBusy" />

            @if (_selectedFileMetadata is not null)
            {
                <dl class="row mb-0 mt-3">
                    <dt class="col-12 col-md-4">File</dt>
                    <dd class="col-12 col-md-8">@_selectedFileMetadata.FileName</dd>

                    <dt class="col-12 col-md-4">Size</dt>
                    <dd class="col-12 col-md-8">@_selectedFileMetadata.SizeBytes bytes</dd>

                    <dt class="col-12 col-md-4">Content type</dt>
                    <dd class="col-12 col-md-8">@_selectedFileMetadata.ContentType</dd>

                    <dt class="col-12 col-md-4">SHA-256</dt>
                    <dd class="col-12 col-md-8 text-break">@_selectedFileMetadata.ByteSha256</dd>
                </dl>
            }
        </section>

        <EditForm Model="_form" OnValidSubmit="RunUploadFlowAsync">
            <section class="border rounded p-3 mt-4">
                <h2 class="h5 mb-1">Upload input</h2>
                <div class="text-body-secondary mb-3">Only business fields remain editable; user, group, and file fields come from the current session, selected group, and selected video.</div>

                <div class="row g-3">
                    <div class="col-12 col-lg-8">
                        <label class="form-label" for="upload-business-object-key">Business object key</label>
                        <InputText id="upload-business-object-key" class="form-control" @bind-Value="_form.BusinessObjectKey" />
                    </div>

                    <div class="col-12 col-lg-4">
                        <label class="form-label" for="upload-device-id">DeviceId</label>
                        <InputText id="upload-device-id" class="form-control" @bind-Value="_form.DeviceId" />
                    </div>
                </div>

                <dl class="row mb-0 mt-3">
                    <dt class="col-12 col-md-4">UserId</dt>
                    <dd class="col-12 col-md-8">@DisplayValue(_form.UserId)</dd>

                    <dt class="col-12 col-md-4">GroupNodeId</dt>
                    <dd class="col-12 col-md-8">@DisplayValue(_form.GroupNodeId)</dd>

                    <dt class="col-12 col-md-4">CapturedAtUtc</dt>
                    <dd class="col-12 col-md-8">@DisplayValue(_form.CapturedAtUtc)</dd>
                </dl>

                <div class="d-flex flex-column flex-md-row align-items-md-center gap-2 mt-4">
                    <button type="submit" class="btn btn-primary" disabled="@(!CanStartUploadFlow)">
                        Start upload flow
                    </button>

                    <button type="button" class="btn btn-outline-secondary" @onclick="ResetResult" disabled="@IsBusy">
                        Clear result
                    </button>
                </div>
            </section>
        </EditForm>

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="alert alert-danger mt-3" role="alert">
                <div class="fw-semibold">Upload flow stopped</div>
                <div>@_errorMessage</div>
            </div>
        }

        @if (_decisionModel is not null)
        {
            <div class="@AlertClass(_decisionModel.Tone)" role="alert">
                <div class="fw-semibold">@_decisionModel.Title</div>
                <div>@_decisionModel.Message</div>

                @if (_preUploadResponse is not null)
                {
                    <dl class="row mb-0 mt-3">
                        <dt class="col-12 col-md-4">PreUploadCheckId</dt>
                        <dd class="col-12 col-md-8">@_preUploadResponse.PreUploadCheckId</dd>
                    </dl>
                }
            </div>
        }

        @if (_directUploadResult is not null)
        {
            <div class="@AlertClass(_directUploadResult.Succeeded ? "success" : "warning")" role="alert">
                <div class="fw-semibold">Local direct-site upload boundary</div>
                <div>@_directUploadResult.Message</div>
            </div>
        }

        @if (_receiptForm is not null)
        {
            <section class="border rounded p-3 mt-3">
                <h2 class="h5">Receipt payload</h2>
                <dl class="row mb-0">
                    <dt class="col-12 col-md-4">ExternalVideoId</dt>
                    <dd class="col-12 col-md-8">@_receiptForm.ExternalVideoId</dd>

                    <dt class="col-12 col-md-4">StorageKey</dt>
                    <dd class="col-12 col-md-8 text-break">@_receiptForm.StorageKey</dd>

                    <dt class="col-12 col-md-4">SiteStatus</dt>
                    <dd class="col-12 col-md-8">@_receiptForm.SiteStatus</dd>

                    <dt class="col-12 col-md-4">IdempotencyKey</dt>
                    <dd class="col-12 col-md-8 text-break">@_receiptForm.IdempotencyKey</dd>
                </dl>
            </section>
        }

        @if (_receiptModel is not null)
        {
            <div class="@AlertClass(_receiptModel.Tone)" role="alert">
                <div class="fw-semibold">@_receiptModel.Title</div>
                <div>@_receiptModel.Message</div>
            </div>
        }
    </div>
}
