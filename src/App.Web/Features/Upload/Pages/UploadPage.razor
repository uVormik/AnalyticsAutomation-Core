@page "/upload"
@using global::App.Web.Features.Upload.ControlPlane
@using Microsoft.AspNetCore.Components.Forms

<div class="container py-4">
    <div class="mb-4">
        <h1 class="h3">Upload</h1>
        <p class="text-body-secondary mb-0">Control plane sign-in, group selection, PreUploadCheck, direct site upload boundary, and UploadReceipt boundary.</p>
    </div>

    <div class="alert alert-info" role="alert">
        This screen uses the backend as a control plane only. Video bytes must not be sent through App.Api.
        The direct site upload adapter is currently an explicit local/client stub boundary until a real site provider is configured.
    </div>

    <section class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <h2 class="h5">Control plane session</h2>
            <p class="text-body-secondary">
                Sign in stores a temporary in-memory session for this page flow. Token values are never displayed.
            </p>

            <EditForm Model="_signInForm" OnValidSubmit="SignInControlPlaneAsync">
                <div class="row g-3">
                    <div class="col-12 col-lg-4">
                        <label class="form-label" for="control-plane-login">Login</label>
                        <InputText id="control-plane-login" class="form-control" @bind-Value="_signInForm.Login" autocomplete="username" />
                    </div>

                    <div class="col-12 col-lg-4">
                        <label class="form-label" for="control-plane-password">Password</label>
                        <input id="control-plane-password" type="password" class="form-control" @bind="_signInForm.Password" autocomplete="current-password" />
                    </div>

                    <div class="col-12 col-lg-4 d-flex align-items-end gap-2">
                        <button type="submit" class="btn btn-primary" disabled="@_isControlPlaneSubmitting">
                            @(_isControlPlaneSubmitting ? "Signing in..." : "Sign in")
                        </button>

                        <button type="button" class="btn btn-outline-secondary" @onclick="ClearControlPlaneSessionAsync" disabled="@_isControlPlaneSubmitting">
                            Clear
                        </button>
                    </div>
                </div>
            </EditForm>

            @if (_sessionSummary is not null)
            {
                <div class="alert alert-success mt-3" role="alert">
                    <div class="fw-semibold">Session ready</div>
                    <div>UserId: @_sessionSummary.UserId</div>
                    <div>DisplayName: @_sessionSummary.DisplayName</div>
                    <div>Access token available: @_sessionSummary.HasAccessToken</div>
                    <div>Refresh token available: @_sessionSummary.HasRefreshToken</div>
                </div>

                <button type="button" class="btn btn-outline-primary" @onclick="LoadGroupTreeNodesAsync" disabled="@_isControlPlaneSubmitting">
                    Load group tree
                </button>
            }

            @if (!string.IsNullOrWhiteSpace(_controlPlaneMessage))
            {
                <div class="alert alert-info mt-3" role="alert">@_controlPlaneMessage</div>
            }

            @if (!string.IsNullOrWhiteSpace(_controlPlaneErrorMessage))
            {
                <div class="alert alert-danger mt-3" role="alert">
                    <div class="fw-semibold">Control plane step failed</div>
                    <div>@_controlPlaneErrorMessage</div>
                </div>
            }

            @if (_groupNodes.Count > 0)
            {
                <div class="table-responsive mt-3">
                    <table class="table table-sm align-middle">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Code</th>
                                <th>Path</th>
                                <th>Selectable</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var node in _groupNodes)
                            {
                                <tr>
                                    <td>@node.Name</td>
                                    <td>@node.Code</td>
                                    <td>@node.Path</td>
                                    <td>@node.IsSelectable</td>
                                    <td>
                                        <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(!node.Id.HasValue)" @onclick="() => UseGroupNode(node)">
                                            Use
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </section>

    <EditForm Model="_form" OnValidSubmit="RunPreUploadCheckAsync">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h2 class="h5">PreUploadCheck</h2>

                <div class="row g-3">
                    <div class="col-12 col-lg-4">
                        <label class="form-label" for="upload-user-id">UserId</label>
                        <InputText id="upload-user-id" class="form-control" @bind-Value="_form.UserId" />
                    </div>

                    <div class="col-12 col-lg-4">
                        <label class="form-label" for="upload-device-id">DeviceId</label>
                        <InputText id="upload-device-id" class="form-control" @bind-Value="_form.DeviceId" />
                    </div>

                    <div class="col-12 col-lg-4">
                        <label class="form-label" for="upload-group-node-id">GroupNodeId</label>
                        <InputText id="upload-group-node-id" class="form-control" @bind-Value="_form.GroupNodeId" />
                    </div>

                    <div class="col-12 col-lg-4">
                        <label class="form-label" for="upload-business-object-key">BusinessObjectKey</label>
                        <InputText id="upload-business-object-key" class="form-control" @bind-Value="_form.BusinessObjectKey" />
                    </div>

                    <div class="col-12 col-lg-4">
                        <label class="form-label" for="upload-file-name">FileName</label>
                        <InputText id="upload-file-name" class="form-control" @bind-Value="_form.FileName" />
                    </div>

                    <div class="col-12 col-lg-4">
                        <label class="form-label" for="upload-size-bytes">SizeBytes</label>
                        <InputNumber id="upload-size-bytes" class="form-control" @bind-Value="_form.SizeBytes" />
                    </div>

                    <div class="col-12 col-lg-8">
                        <label class="form-label" for="upload-byte-sha256">ByteSha256</label>
                        <InputText id="upload-byte-sha256" class="form-control" @bind-Value="_form.ByteSha256" />
                    </div>

                    <div class="col-12 col-lg-4">
                        <label class="form-label" for="upload-content-type">ContentType</label>
                        <InputText id="upload-content-type" class="form-control" @bind-Value="_form.ContentType" />
                    </div>

                    <div class="col-12 col-lg-6">
                        <label class="form-label" for="upload-captured-at-utc">CapturedAtUtc</label>
                        <InputText id="upload-captured-at-utc" class="form-control" @bind-Value="_form.CapturedAtUtc" />
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2 mt-4">
                    <button type="submit" class="btn btn-primary" disabled="@_isSubmitting">
                        @(_isSubmitting ? "Checking..." : "Run pre-upload check")
                    </button>

                    <button type="button" class="btn btn-outline-secondary" @onclick="ResetResult" disabled="@_isSubmitting">
                        Clear result
                    </button>
                </div>
            </div>
        </div>
    </EditForm>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert alert-danger mt-3" role="alert">
            <div class="fw-semibold">Upload flow step failed</div>
            <div>@_errorMessage</div>
        </div>
    }

    @if (_decisionModel is not null)
    {
        <div class="@AlertClass(_decisionModel.Tone)" role="alert">
            <div class="fw-semibold">@_decisionModel.Title</div>
            <div>@_decisionModel.Message</div>
        </div>

        <div class="card border-0 shadow-sm mt-3">
            <div class="card-body d-grid gap-2">
                <div class="d-flex align-items-start justify-content-between gap-3">
                    <div>
                        <div class="fw-semibold">Backend decision</div>
                        <div class="text-body-secondary small">@_decisionModel.Decision</div>
                    </div>

                    <span class="@(_decisionModel.CanContinue ? "badge text-bg-success" : "badge text-bg-danger")">
                        @(_decisionModel.CanContinue ? "Can continue" : "Stop")
                    </span>
                </div>

                @if (_preUploadResponse is not null)
                {
                    <dl class="row mb-0">
                        <dt class="col-12 col-md-4">PreUploadCheckId</dt>
                        <dd class="col-12 col-md-8">@_preUploadResponse.PreUploadCheckId</dd>
                    </dl>
                }

                <button type="button" class="btn btn-outline-primary" disabled="@(!CanRunDirectUploadBoundary)" @onclick="RunDirectSiteUploadBoundaryAsync">
                    Run local direct-site upload stub boundary
                </button>
            </div>
        </div>
    }

    @if (_directUploadResult is not null)
    {
        <div class="@AlertClass(_directUploadResult.Succeeded ? "success" : "warning")" role="alert">
            <div class="fw-semibold">Direct site upload adapter boundary</div>
            <div>@_directUploadResult.Message</div>
        </div>
    }

    @if (_receiptForm is not null)
    {
        <div class="card border-0 shadow-sm mt-3">
            <div class="card-body d-grid gap-2">
                <div class="fw-semibold">UploadReceipt boundary payload</div>
                <div class="text-body-secondary small">Submitting again reuses the same idempotency key until the result is cleared.</div>

                <dl class="row mb-0">
                    <dt class="col-12 col-md-4">PreUploadCheckId</dt>
                    <dd class="col-12 col-md-8">@_receiptForm.PreUploadCheckId</dd>

                    <dt class="col-12 col-md-4">ExternalVideoId</dt>
                    <dd class="col-12 col-md-8">@_receiptForm.ExternalVideoId</dd>

                    <dt class="col-12 col-md-4">StorageKey</dt>
                    <dd class="col-12 col-md-8">@_receiptForm.StorageKey</dd>

                    <dt class="col-12 col-md-4">SiteStatus</dt>
                    <dd class="col-12 col-md-8">@_receiptForm.SiteStatus</dd>

                    <dt class="col-12 col-md-4">IdempotencyKey</dt>
                    <dd class="col-12 col-md-8">@_receiptForm.IdempotencyKey</dd>
                </dl>

                <button type="button" class="btn btn-success" disabled="@(!CanSubmitUploadReceipt)" @onclick="SubmitUploadReceiptAsync">
                    Submit UploadReceipt
                </button>
            </div>
        </div>
    }

    @if (_receiptModel is not null)
    {
        <div class="@AlertClass(_receiptModel.Tone)" role="alert">
            <div class="fw-semibold">@_receiptModel.Title</div>
            <div>@_receiptModel.Message</div>
        </div>
    }
</div>