@page "/reports/{DraftId}"
@using global::App.Mobile.Android.Localization
@inject global::App.Mobile.Android.Navigation.MobileNavigationState NavigationState
@inject global::App.Mobile.Android.Services.Abstractions.IMobileMediaService MobileMediaService
@inject global::App.Mobile.Android.Services.Abstractions.IMobileReportDraftStore ReportDraftStore
@inject global::App.Mobile.Android.Services.Abstractions.IMobileOutboxService MobileOutboxService
@inject global::App.Mobile.Android.Services.Abstractions.IMobileLookupCatalogProvider LookupCatalogProvider
@inject global::App.Mobile.Android.Services.Abstractions.IMobileSelectedMediaStore SelectedMediaStore
@inject global::App.Mobile.Android.Services.Abstractions.IMobileReportDraftValidationService ReportDraftValidationService

@if (Draft is null)
{
    <h1>@MobileUiText.ReportDraftNotFoundTitle</h1>
    <p>@MobileUiText.ReportDraftNotFoundMessage</p>
}
else
{
    <h1>@MobileUiText.ReportDraftPageTitle</h1>

    <section class="report-draft-shell">
        <header class="report-draft-header">
            <div>
                <h2>@Draft.Title</h2>
                <p class="report-draft-status">@MobileUiText.GetReportDraftStatusText(Draft.Status)</p>
            </div>
            <dl class="report-draft-meta">
                <div>
                    <dt>@MobileUiText.ReportDraftCardCreatedAtLabel</dt>
                    <dd>@FormatTimestamp(Draft.CreatedAtUtc)</dd>
                </div>
                <div>
                    <dt>@MobileUiText.ReportDraftCardUpdatedAtLabel</dt>
                    <dd>@FormatTimestamp(Draft.UpdatedAtUtc)</dd>
                </div>
                <div>
                    <dt>@MobileUiText.ReportDraftCardAttachmentCountLabel</dt>
                    <dd>@Draft.Attachments.Count</dd>
                </div>
            </dl>
        </header>

        <p class="report-draft-note">@MobileUiText.ReportDraftLocalOnlyNote</p>
        <p class="report-draft-note report-draft-note-secondary">@MobileUiText.GetReportDraftLocalPersistenceWarningText()</p>
        @if (Draft.IsRestoredFromSnapshot)
        {
            <p class="report-draft-note report-draft-note-restored">@MobileUiText.GetReportDraftRestoredFromSnapshotText()</p>
        }

        @if (!string.IsNullOrWhiteSpace(FieldResultText))
        {
            <p class="@(FieldResultIsWarning ? "report-draft-result report-draft-result-warning" : "report-draft-result")">
                @FieldResultText
            </p>
        }

        @foreach (var sectionKey in SectionOrder)
        {
            var sectionFields = GetFieldsForSection(sectionKey);

            if (sectionFields.Count == 0)
            {
                continue;
            }

            <section class="report-draft-section">
                <h3>@GetSectionTitle(sectionKey)</h3>

                <div class="report-draft-fields">
                    @foreach (var field in sectionFields)
                    {
                        <article class="report-draft-field-row">
                            <div class="report-draft-field-header">
                                <div class="report-draft-field-heading">
                                    <h4>
                                        @field.Label
                                        @if (field.IsRequired)
                                        {
                                            <span class="report-draft-required-mark">@MobileUiText.ReportDraftFieldRequiredMark</span>
                                        }
                                    </h4>
                                    @if (field.LastUpdatedAtUtc is not null)
                                    {
                                        <p class="report-draft-field-updated-at">@FormatTimestamp(field.LastUpdatedAtUtc.Value)</p>
                                    }
                                </div>

                                @if (IsSelectorField(field))
                                {
                                    <button type="button"
                                            class="btn btn-outline-secondary"
                                            @onclick="() => ToggleSelectorPanel(field)">
                                        @MobileUiText.ReportDraftOpenSelectorButton
                                    </button>
                                }
                                else if (!IsToggleField(field))
                                {
                                    <button type="button"
                                            class="btn btn-outline-secondary"
                                            @onclick="() => StartFieldEdit(field)">
                                        @MobileUiText.ReportDraftEditFieldButton
                                    </button>
                                }
                            </div>

                            @if (IsEditingField(field.FieldKey))
                            {
                                <div class="report-draft-inline-editor">
                                    <input type="@GetInputType(field)"
                                           class="form-control"
                                           placeholder="@MobileUiText.GetReportDraftFieldEditorPlaceholderText(field.FieldKind)"
                                           @bind="EditingValueText" />
                                    <div class="report-draft-inline-editor-actions">
                                        <button type="button"
                                                class="btn btn-primary"
                                                @onclick="() => SaveFieldEditAsync(field)">
                                            @MobileUiText.ReportDraftSaveFieldValueButton
                                        </button>
                                        <button type="button"
                                                class="btn btn-outline-secondary"
                                                @onclick="CancelFieldEdit">
                                            @MobileUiText.ReportDraftCancelFieldEditButton
                                        </button>
                                    </div>
                                </div>
                            }
                            else if (IsToggleField(field))
                            {
                                <div class="report-draft-toggle-shell">
                                    <p class="@(field.IsPlaceholder ? "report-draft-field-placeholder" : "report-draft-field-value")">
                                        @GetFieldDisplayText(field)
                                    </p>
                                    <div class="report-draft-toggle-actions">
                                        <button type="button"
                                                class="@(IsToggleValueSelected(field, true) ? "btn btn-primary" : "btn btn-outline-secondary")"
                                                @onclick="() => SetToggleFieldAsync(field, true)">
                                            @MobileUiText.ReportDraftToggleYesText
                                        </button>
                                        <button type="button"
                                                class="@(IsToggleValueSelected(field, false) ? "btn btn-primary" : "btn btn-outline-secondary")"
                                                @onclick="() => SetToggleFieldAsync(field, false)">
                                            @MobileUiText.ReportDraftToggleNoText
                                        </button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <p class="@(field.IsPlaceholder ? "report-draft-field-placeholder" : "report-draft-field-value")">
                                    @GetFieldDisplayText(field)
                                </p>
                            }

                            @if (IsSelectorOpen(field.FieldKey))
                            {
                                <div class="report-draft-selector-panel">
                                    <div class="report-draft-selector-header">
                                        <h5>@MobileUiText.ReportDraftSelectorSheetTitle</h5>
                                        <button type="button"
                                                class="btn btn-outline-secondary"
                                                @onclick="CloseSelectorPanel">
                                            @MobileUiText.ReportDraftCancelFieldEditButton
                                        </button>
                                    </div>

                                    <input type="search"
                                           class="form-control"
                                           placeholder="@MobileUiText.ReportDraftSelectorSearchPlaceholder"
                                           @bind="SelectorSearchText"
                                           @bind:event="oninput" />

                                    <p class="report-draft-selector-warning">@MobileUiText.ReportDraftStubCatalogWarning</p>

                                    @if (VisibleSelectorOptions.Count == 0)
                                    {
                                        <p class="report-draft-selector-empty">@MobileUiText.ReportDraftSelectorEmptyState</p>
                                    }
                                    else
                                    {
                                        <div class="report-draft-selector-options">
                                            @foreach (var option in VisibleSelectorOptions)
                                            {
                                                <button type="button"
                                                        class="@(IsSelectorOptionSelected(option.OptionKey) ? "report-draft-selector-option report-draft-selector-option-active" : "report-draft-selector-option")"
                                                        @onclick="() => SelectOptionAsync(field, option)">
                                                    @option.DisplayText
                                                </button>
                                            }
                                        </div>
                                    }

                                    <div class="report-draft-selector-actions">
                                        @if (RequiresConfirmApply(field))
                                        {
                                            <button type="button"
                                                    class="btn btn-primary"
                                                    @onclick="() => ApplyPendingSelectorAsync(field)"
                                                    disabled="@string.IsNullOrWhiteSpace(PendingSelectorOptionKey)">
                                                @MobileUiText.ReportDraftSelectorApplyButton
                                            </button>
                                        }

                                        <button type="button"
                                                class="btn btn-outline-secondary"
                                                @onclick="() => ClearSelectorValueAsync(field)">
                                            @MobileUiText.ReportDraftSelectorClearButton
                                        </button>
                                    </div>
                                </div>
                            }
                        </article>
                    }
                </div>
            </section>
        }

        <section class="report-draft-section">
            <h3>@MobileUiText.ReportDraftMediaSectionTitle</h3>

            <div class="report-draft-media-shell">
                <article class="report-draft-media-card">
                    <div class="report-draft-media-card-header">
                        <div>
                            <h4>@MobileUiText.ReportDraftVideoBlockTitle</h4>
                            <p>@MobileUiText.ReportDraftLocalOnlyNote</p>
                        </div>
                    </div>

                    <div class="report-draft-attachment-actions">
                        <button type="button"
                                class="btn btn-primary"
                                @onclick="PickAndAttachVideoAsync"
                                disabled="@IsMediaOperationInProgress">
                            @MobileUiText.ReportDraftPickVideoButton
                        </button>
                        <button type="button"
                                class="btn btn-outline-secondary"
                                @onclick="CaptureAndAttachVideoAsync"
                                disabled="@IsMediaOperationInProgress">
                            @MobileUiText.ReportDraftCaptureVideoButton
                        </button>
                    </div>
                </article>

                <article class="report-draft-media-card report-draft-media-card-disabled">
                    <div class="report-draft-media-card-header">
                        <div>
                            <h4>@MobileUiText.ReportDraftPhotoBlockTitle</h4>
                            <p>@MobileUiText.ReportDraftFutureAttachmentNote</p>
                        </div>
                    </div>

                    <button type="button" class="btn btn-outline-secondary" disabled>Скоро</button>
                </article>

                <article class="report-draft-media-card report-draft-media-card-disabled">
                    <div class="report-draft-media-card-header">
                        <div>
                            <h4>@MobileUiText.ReportDraftLogFileBlockTitle</h4>
                            <p>@MobileUiText.ReportDraftFutureAttachmentNote</p>
                        </div>
                    </div>

                    <button type="button" class="btn btn-outline-secondary" disabled>Скоро</button>
                </article>
            </div>

            @if (IsMediaOperationInProgress)
            {
                <p class="report-draft-result">@ProgressText</p>
            }
            else if (!string.IsNullOrWhiteSpace(ActionResultText))
            {
                <p class="@(ActionResultIsWarning ? "report-draft-result report-draft-result-warning" : "report-draft-result")">
                    @ActionResultText
                </p>
            }

            @if (Draft.Attachments.Count == 0)
            {
                <p class="report-draft-empty-attachments">@MobileUiText.ReportDraftNoAttachmentsText</p>
            }
            else
            {
                <div class="report-draft-attachments">
                    @foreach (var attachment in Draft.Attachments)
                    {
                        <article class="report-draft-attachment-card">
                            <dl class="report-draft-attachment-meta">
                                <div>
                                    <dt>@MobileUiText.ReportAttachmentKindLabel</dt>
                                    <dd>@MobileUiText.GetReportAttachmentKindText(attachment.Kind)</dd>
                                </div>
                                <div>
                                    <dt>@MobileUiText.ReportAttachmentFileNameLabel</dt>
                                    <dd>@attachment.FileName</dd>
                                </div>
                                <div>
                                    <dt>@MobileUiText.ReportAttachmentContentTypeLabel</dt>
                                    <dd>@GetContentTypeText(attachment.ContentType)</dd>
                                </div>
                                <div>
                                    <dt>@MobileUiText.ReportAttachmentSourceLabel</dt>
                                    <dd>@attachment.SourceText</dd>
                                </div>
                                <div>
                                    <dt>@MobileUiText.ReportAttachmentAddedAtLabel</dt>
                                    <dd>@FormatTimestamp(attachment.AddedAtUtc)</dd>
                                </div>
                                <div>
                                    <dt>@MobileUiText.ReportAttachmentLocalAccessLabel</dt>
                                    <dd>@MobileUiText.GetReportAttachmentLocalAccessText(attachment.HasLocalReadHandle)</dd>
                                </div>
                            </dl>

                            @if (!attachment.HasLocalReadHandle)
                            {
                                <p class="report-draft-attachment-note">@MobileUiText.GetReportDraftRestoredAttachmentMetadataOnlyText()</p>
                            }
                        </article>
                    }
                </div>
            }

            @if (ValidationResult is not null)
            {
                <section class="@(ValidationResult.IsValidForLocalQueue ? "report-draft-validation report-draft-validation-ready" : "report-draft-validation report-draft-validation-not-ready")">
                    <div class="report-draft-validation-header">
                        <div>
                            <h4>@MobileUiText.GetReportDraftValidationSummaryTitle()</h4>
                            <p class="report-draft-validation-status">
                                @MobileUiText.GetReportDraftValidationStatusText(ValidationResult.IsValidForLocalQueue)
                            </p>
                        </div>
                        <span class="report-draft-validation-count">
                            @MobileUiText.GetReportDraftValidationIssueCountText(ValidationResult.Issues.Count)
                        </span>
                    </div>

                    <p class="report-draft-validation-summary">@ValidationResult.SummaryText</p>

                    @if (ValidationResult.Issues.Count == 0)
                    {
                        <p class="report-draft-validation-passed">@MobileUiText.GetReportDraftValidationPassedText()</p>
                    }
                    else
                    {
                        <ul class="report-draft-validation-issues">
                            @foreach (var issue in ValidationResult.Issues)
                            {
                                <li class="@GetValidationIssueClass(issue)">@issue.Message</li>
                            }
                        </ul>
                    }

                    <p class="report-draft-validation-note">@MobileUiText.GetReportDraftValidationLocalOnlyNote()</p>
                </section>
            }

            <div class="report-draft-queue-shell">
                <button type="button"
                        class="btn btn-outline-primary"
                        @onclick="QueueDraftAsync"
                        disabled="@IsMediaOperationInProgress">
                    @MobileUiText.ReportDraftQueueButton
                </button>
                <p class="report-draft-queue-note">@MobileUiText.ReportDraftQueueLocalOnlyNoteText</p>
            </div>
        </section>
    </section>
}

@code {
    private static readonly string[] SectionOrder =
    [
        "basic-data",
        "target-result",
        "frequencies-parameters"
    ];

    private global::App.Mobile.Android.Reports.MobileReportDraft? Draft { get; set; }

    private global::App.Mobile.Android.Lookup.MobileLookupCatalogSnapshot? Catalog { get; set; }

    private global::App.Mobile.Android.Reports.Validation.MobileReportDraftValidationResult? ValidationResult { get; set; }

    private string ActionResultText { get; set; } = string.Empty;

    private bool ActionResultIsWarning { get; set; }

    private string FieldResultText { get; set; } = string.Empty;

    private bool FieldResultIsWarning { get; set; }

    private string ProgressText { get; set; } = string.Empty;

    private bool IsMediaOperationInProgress { get; set; }

    private string? EditingFieldKey { get; set; }

    private string EditingValueText { get; set; } = string.Empty;

    private string? ActiveSelectorFieldKey { get; set; }

    private string SelectorSearchText { get; set; } = string.Empty;

    private string? PendingSelectorOptionKey { get; set; }

    private global::App.Mobile.Android.Lookup.MobileLookupSelectionResult? SelectorSelection { get; set; }

    [Parameter]
    public string DraftId { get; set; } = string.Empty;

    private IReadOnlyList<global::App.Mobile.Android.Lookup.MobileLookupOption> VisibleSelectorOptions =>
        GetVisibleSelectorOptions();

    protected override async Task OnParametersSetAsync()
    {
        NavigationState.SetCurrentView(global::App.Mobile.Android.Navigation.MobileViewId.Reports);
        Catalog ??= await LookupCatalogProvider.GetReportDraftFieldsAsync();
        Draft = await ReportDraftStore.GetDraftAsync(DraftId);
        RefreshValidation();
    }

    private async Task PickAndAttachVideoAsync()
    {
        await RunMediaAttachAsync(
            () => MobileMediaService.PickVideoAsync(),
            MobileUiText.ReportDraftPickVideoProgressText);
    }

    private async Task CaptureAndAttachVideoAsync()
    {
        await RunMediaAttachAsync(
            () => MobileMediaService.CaptureVideoAsync(),
            MobileUiText.ReportDraftCaptureVideoProgressText);
    }

    private async Task QueueDraftAsync()
    {
        if (Draft is null)
        {
            RefreshValidation();
            return;
        }

        ActionResultText = string.Empty;
        ActionResultIsWarning = false;
        RefreshValidation();

        if (ValidationResult is null || !ValidationResult.IsValidForLocalQueue)
        {
            ActionResultText = $"{MobileUiText.GetReportDraftQueueBlockedByValidationText()} {ValidationResult?.SummaryText}".Trim();
            ActionResultIsWarning = true;
            return;
        }

        var queueResult = await MobileOutboxService.EnqueueReportDraftAsync(Draft);
        if (!queueResult.Applied)
        {
            ActionResultText = queueResult.Message;
            ActionResultIsWarning = true;
            RefreshValidation();
            return;
        }

        var markResult = await ReportDraftStore.MarkDraftQueuedLocalAsync(Draft.DraftId);
        Draft = markResult.Draft ?? await ReportDraftStore.GetDraftAsync(DraftId);
        RefreshValidation();
        ActionResultText = markResult.Applied ? queueResult.Message : markResult.Message;
        ActionResultIsWarning = !markResult.Applied;
    }

    private void StartFieldEdit(global::App.Mobile.Android.Reports.MobileReportDraftFieldValue field)
    {
        CloseSelectorPanel();
        ClearFieldResult();
        EditingFieldKey = field.FieldKey;
        EditingValueText = GetEditableValue(field);
    }

    private void CancelFieldEdit()
    {
        EditingFieldKey = null;
        EditingValueText = string.Empty;
    }

    private async Task SaveFieldEditAsync(global::App.Mobile.Android.Reports.MobileReportDraftFieldValue field)
    {
        var normalizedValue = NormalizeFieldInput(field, EditingValueText);
        var result = await ReportDraftStore.UpdateFieldValueAsync(DraftId, field.FieldKey, normalizedValue);
        ApplyFieldOperationResult(result);
        CancelFieldEdit();
    }

    private async Task SetToggleFieldAsync(
        global::App.Mobile.Android.Reports.MobileReportDraftFieldValue field,
        bool value)
    {
        CloseSelectorPanel();
        CancelFieldEdit();

        var result = await ReportDraftStore.UpdateFieldValueAsync(
            DraftId,
            field.FieldKey,
            MobileUiText.GetToggleValueText(value));

        ApplyFieldOperationResult(result);
    }

    private void ToggleSelectorPanel(global::App.Mobile.Android.Reports.MobileReportDraftFieldValue field)
    {
        CancelFieldEdit();
        ClearFieldResult();

        if (string.Equals(ActiveSelectorFieldKey, field.FieldKey, StringComparison.Ordinal))
        {
            CloseSelectorPanel();
            return;
        }

        ActiveSelectorFieldKey = field.FieldKey;
        SelectorSearchText = string.Empty;
        PendingSelectorOptionKey = FindSelectedOptionKey(field);
        SelectorSelection = null;
    }

    private void CloseSelectorPanel()
    {
        ActiveSelectorFieldKey = null;
        SelectorSearchText = string.Empty;
        PendingSelectorOptionKey = null;
        SelectorSelection = null;
    }

    private async Task SelectOptionAsync(
        global::App.Mobile.Android.Reports.MobileReportDraftFieldValue field,
        global::App.Mobile.Android.Lookup.MobileLookupOption option)
    {
        SelectorSelection = new global::App.Mobile.Android.Lookup.MobileLookupSelectionResult(
            Applied: !RequiresConfirmApply(field),
            FieldKey: field.FieldKey,
            SelectedDisplayText: option.DisplayText,
            Message: option.DisplayText);

        PendingSelectorOptionKey = option.OptionKey;

        if (!RequiresConfirmApply(field))
        {
            var result = await ReportDraftStore.UpdateFieldValueAsync(DraftId, field.FieldKey, option.DisplayText);
            ApplyFieldOperationResult(result);
            CloseSelectorPanel();
        }
    }

    private async Task ApplyPendingSelectorAsync(global::App.Mobile.Android.Reports.MobileReportDraftFieldValue field)
    {
        if (string.IsNullOrWhiteSpace(PendingSelectorOptionKey))
        {
            return;
        }

        var selectedOption = GetSelectorOptions(field.FieldKey)
            .FirstOrDefault(option => string.Equals(option.OptionKey, PendingSelectorOptionKey, StringComparison.Ordinal));

        if (selectedOption is null)
        {
            FieldResultText = MobileUiText.ReportDraftFieldUpdateFailedMessage;
            FieldResultIsWarning = true;
            return;
        }

        SelectorSelection = new global::App.Mobile.Android.Lookup.MobileLookupSelectionResult(
            Applied: true,
            FieldKey: field.FieldKey,
            SelectedDisplayText: selectedOption.DisplayText,
            Message: selectedOption.DisplayText);

        var result = await ReportDraftStore.UpdateFieldValueAsync(DraftId, field.FieldKey, selectedOption.DisplayText);
        ApplyFieldOperationResult(result);
        CloseSelectorPanel();
    }

    private async Task ClearSelectorValueAsync(global::App.Mobile.Android.Reports.MobileReportDraftFieldValue field)
    {
        var result = await ReportDraftStore.UpdateFieldValueAsync(DraftId, field.FieldKey, string.Empty);
        ApplyFieldOperationResult(result);
        CloseSelectorPanel();
    }

    private async Task RunMediaAttachAsync(
        Func<Task<global::App.Mobile.Android.Media.MobileMediaOperationResult>> operation,
        string progressText)
    {
        IsMediaOperationInProgress = true;
        ProgressText = progressText;
        ActionResultText = string.Empty;
        ActionResultIsWarning = false;

        try
        {
            var result = await operation();
            if (!IsSuccessfulMediaOperation(result.Status))
            {
                ActionResultText = result.Message;
                ActionResultIsWarning = true;
                return;
            }

            await AttachCurrentSelectionAsync();
        }
        finally
        {
            IsMediaOperationInProgress = false;
            ProgressText = string.Empty;
        }
    }

    private async Task AttachCurrentSelectionAsync()
    {
        if (Draft is null)
        {
            RefreshValidation();
            return;
        }

        var selectedMedia = await SelectedMediaStore.GetCurrentAsync();
        if (selectedMedia is null)
        {
            ActionResultText = MobileUiText.ReportDraftNoCurrentSelectedVideoText;
            ActionResultIsWarning = true;
            RefreshValidation();
            return;
        }

        var operationResult = await ReportDraftStore.AttachSelectedVideoAsync(Draft.DraftId, selectedMedia);
        Draft = operationResult.Draft ?? await ReportDraftStore.GetDraftAsync(DraftId);
        RefreshValidation();
        ActionResultText = operationResult.Message;
        ActionResultIsWarning = !operationResult.Applied;
    }

    private IReadOnlyList<global::App.Mobile.Android.Reports.MobileReportDraftFieldValue> GetFieldsForSection(string sectionKey)
    {
        if (Draft is null || Catalog is null)
        {
            return Array.Empty<global::App.Mobile.Android.Reports.MobileReportDraftFieldValue>();
        }

        var fieldsByKey = Draft.Fields.ToDictionary(field => field.FieldKey, StringComparer.Ordinal);

        return Catalog.Fields
            .Where(field => string.Equals(field.SectionKey, sectionKey, StringComparison.Ordinal))
            .Select(field => fieldsByKey.TryGetValue(field.FieldKey, out var value) ? value : null)
            .Where(value => value is not null)
            .Select(value => value!)
            .ToArray();
    }

    private IReadOnlyList<global::App.Mobile.Android.Lookup.MobileLookupOption> GetVisibleSelectorOptions()
    {
        if (string.IsNullOrWhiteSpace(ActiveSelectorFieldKey))
        {
            return Array.Empty<global::App.Mobile.Android.Lookup.MobileLookupOption>();
        }

        return GetSelectorOptions(ActiveSelectorFieldKey)
            .Where(option =>
                string.IsNullOrWhiteSpace(SelectorSearchText)
                || option.DisplayText.Contains(SelectorSearchText, StringComparison.OrdinalIgnoreCase))
            .OrderBy(option => option.SortOrder)
            .ThenBy(option => option.DisplayText, StringComparer.OrdinalIgnoreCase)
            .ToArray();
    }

    private IReadOnlyList<global::App.Mobile.Android.Lookup.MobileLookupOption> GetSelectorOptions(string fieldKey)
    {
        if (Catalog is null || !Catalog.OptionsByFieldKey.TryGetValue(fieldKey, out var options))
        {
            return Array.Empty<global::App.Mobile.Android.Lookup.MobileLookupOption>();
        }

        return options;
    }

    private bool IsEditingField(string fieldKey)
    {
        return string.Equals(EditingFieldKey, fieldKey, StringComparison.Ordinal);
    }

    private bool IsSelectorOpen(string fieldKey)
    {
        return string.Equals(ActiveSelectorFieldKey, fieldKey, StringComparison.Ordinal);
    }

    private static bool IsSelectorField(global::App.Mobile.Android.Reports.MobileReportDraftFieldValue field)
    {
        return field.FieldKind is global::App.Mobile.Android.Lookup.MobileLookupFieldKind.SearchableSingleSelect
            or global::App.Mobile.Android.Lookup.MobileLookupFieldKind.ConfirmApplySelector;
    }

    private static bool IsToggleField(global::App.Mobile.Android.Reports.MobileReportDraftFieldValue field)
    {
        return field.FieldKind == global::App.Mobile.Android.Lookup.MobileLookupFieldKind.Toggle;
    }

    private static bool RequiresConfirmApply(global::App.Mobile.Android.Reports.MobileReportDraftFieldValue field)
    {
        return field.SelectorMode == global::App.Mobile.Android.Lookup.MobileLookupSelectorMode.ConfirmApply;
    }

    private static bool IsSuccessfulMediaOperation(global::App.Mobile.Android.Media.MobileMediaOperationStatus status)
    {
        return status is global::App.Mobile.Android.Media.MobileMediaOperationStatus.DeviceSelectionCompleted
            or global::App.Mobile.Android.Media.MobileMediaOperationStatus.DeviceCaptureCompleted
            or global::App.Mobile.Android.Media.MobileMediaOperationStatus.StubCompleted;
    }

    private bool IsSelectorOptionSelected(string optionKey)
    {
        return string.Equals(PendingSelectorOptionKey, optionKey, StringComparison.Ordinal);
    }

    private string? FindSelectedOptionKey(global::App.Mobile.Android.Reports.MobileReportDraftFieldValue field)
    {
        return GetSelectorOptions(field.FieldKey)
            .FirstOrDefault(option => string.Equals(option.DisplayText, field.ValueText, StringComparison.Ordinal))
            ?.OptionKey;
    }

    private static bool IsToggleValueSelected(
        global::App.Mobile.Android.Reports.MobileReportDraftFieldValue field,
        bool value)
    {
        return string.Equals(
            field.ValueText,
            MobileUiText.GetToggleValueText(value),
            StringComparison.OrdinalIgnoreCase);
    }

    private static string GetEditableValue(global::App.Mobile.Android.Reports.MobileReportDraftFieldValue field)
    {
        if (field.IsPlaceholder || string.IsNullOrWhiteSpace(field.ValueText))
        {
            return string.Empty;
        }

        if (field.FieldKind == global::App.Mobile.Android.Lookup.MobileLookupFieldKind.DateTime
            && DateTimeOffset.TryParse(field.ValueText, out var timestamp))
        {
            return timestamp.ToLocalTime().ToString("yyyy-MM-ddTHH:mm");
        }

        return field.ValueText;
    }

    private static string NormalizeFieldInput(
        global::App.Mobile.Android.Reports.MobileReportDraftFieldValue field,
        string? rawValue)
    {
        if (field.FieldKind == global::App.Mobile.Android.Lookup.MobileLookupFieldKind.DateTime
            && !string.IsNullOrWhiteSpace(rawValue)
            && DateTime.TryParse(rawValue, out var parsedDateTime))
        {
            return new DateTimeOffset(parsedDateTime).ToString("dd.MM.yyyy HH:mm");
        }

        return string.IsNullOrWhiteSpace(rawValue)
            ? string.Empty
            : rawValue.Trim();
    }

    private static string GetInputType(global::App.Mobile.Android.Reports.MobileReportDraftFieldValue field)
    {
        return field.FieldKind switch
        {
            global::App.Mobile.Android.Lookup.MobileLookupFieldKind.Number => "number",
            global::App.Mobile.Android.Lookup.MobileLookupFieldKind.DateTime => "datetime-local",
            _ => "text"
        };
    }

    private static string GetFieldDisplayText(global::App.Mobile.Android.Reports.MobileReportDraftFieldValue field)
    {
        if (field.IsPlaceholder)
        {
            return MobileUiText.ReportFieldPlaceholderText;
        }

        if (field.FieldKind == global::App.Mobile.Android.Lookup.MobileLookupFieldKind.Toggle)
        {
            if (string.Equals(field.ValueText, MobileUiText.ReportDraftToggleYesText, StringComparison.OrdinalIgnoreCase))
            {
                return MobileUiText.ReportDraftToggleYesText;
            }

            if (string.Equals(field.ValueText, MobileUiText.ReportDraftToggleNoText, StringComparison.OrdinalIgnoreCase))
            {
                return MobileUiText.ReportDraftToggleNoText;
            }
        }

        if (!string.IsNullOrWhiteSpace(field.ValueText))
        {
            return field.ValueText;
        }

        return "Нет значения";
    }

    private string GetValidationIssueClass(global::App.Mobile.Android.Reports.Validation.MobileReportDraftValidationIssue issue)
    {
        return issue.Severity switch
        {
            global::App.Mobile.Android.Reports.Validation.MobileReportDraftValidationSeverity.Info =>
                "report-draft-validation-issue report-draft-validation-issue-info",
            global::App.Mobile.Android.Reports.Validation.MobileReportDraftValidationSeverity.Warning =>
                "report-draft-validation-issue report-draft-validation-issue-warning",
            _ =>
                "report-draft-validation-issue report-draft-validation-issue-error"
        };
    }

    private void ApplyFieldOperationResult(global::App.Mobile.Android.Reports.MobileReportDraftOperationResult result)
    {
        Draft = result.Draft ?? Draft;
        RefreshValidation();
        FieldResultText = result.Message;
        FieldResultIsWarning = !result.Applied;
    }

    private void RefreshValidation()
    {
        ValidationResult = ReportDraftValidationService.ValidateForLocalQueue(Draft);
    }

    private void ClearFieldResult()
    {
        FieldResultText = string.Empty;
        FieldResultIsWarning = false;
    }

    private static string GetSectionTitle(string sectionKey)
    {
        return sectionKey switch
        {
            "basic-data" => MobileUiText.ReportSectionBasicDataTitle,
            "target-result" => MobileUiText.ReportSectionTargetAndResultTitle,
            "frequencies-parameters" => MobileUiText.ReportSectionFrequenciesAndParametersTitle,
            _ => MobileUiText.ReportSectionBasicDataTitle
        };
    }

    private static string FormatTimestamp(DateTimeOffset value)
    {
        return value.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss");
    }

    private static string GetContentTypeText(string? contentType)
    {
        return string.IsNullOrWhiteSpace(contentType)
            ? MobileUiText.UploadUnknownContentTypeText
            : contentType;
    }
}
