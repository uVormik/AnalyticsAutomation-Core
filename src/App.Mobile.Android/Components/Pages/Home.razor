@page "/"
@using global::App.Mobile.Android.Localization
@inject global::App.Mobile.Android.Navigation.MobileNavigationState NavigationState

<section>
    <h1>@MobileUiText.HomeLandingTitle</h1>
    <p>@MobileUiText.HomeLandingText</p>
    <a class="btn btn-primary" href="/reports">@MobileUiText.HomeOpenReportsButton</a>
</section>

@code {
    protected override void OnInitialized()
    {
        NavigationState.SetCurrentView(global::App.Mobile.Android.Navigation.MobileViewId.Reports);
    }
}
