@page "/queue"
@using global::App.Mobile.Android.Localization
@inject global::App.Mobile.Android.Navigation.MobileNavigationState NavigationState
@inject global::App.Mobile.Android.Services.Abstractions.IFeatureFlagReader FeatureFlagReader
@inject global::App.Mobile.Android.Services.Abstractions.IMobileOutboxService MobileOutboxService

<h1>@MobileUiText.QueueTitle</h1>
<p>@MobileUiText.QueueIntro</p>

@if (ShowQueueFoundation)
{
    <section class="queue-foundation-card">
        <h2>@MobileUiText.QueueFoundationCardTitle</h2>
        <p class="queue-foundation-summary">@MobileUiText.QueueFoundationCardSummary</p>

        @if (IsLoading)
        {
            <p class="queue-loading">@MobileUiText.QueueLoadingText</p>
        }
        else if (Items.Count == 0)
        {
            <div class="queue-empty-state">
                <h3>@MobileUiText.QueueEmptyTitle</h3>
                <p>@MobileUiText.QueueEmptyMessage</p>
            </div>
        }
        else
        {
            <div class="queue-item-list">
                @foreach (var item in Items)
                {
                    <article class="queue-item-card">
                        <header class="queue-item-header">
                            <h3>@item.Title</h3>
                            <span class="queue-item-status">@MobileUiText.GetPendingSyncStatusText(item.Status)</span>
                        </header>

                        <p class="queue-item-summary">@item.SummaryText</p>

                        @if (item.LocalMediaDraft is not null)
                        {
                            <section class="queue-media-draft">
                                <dl class="queue-item-meta">
                                    <div>
                                        <dt>@MobileUiText.QueueMediaSourceLabel</dt>
                                        <dd>@MobileUiText.GetSelectedMediaSourceText(item.LocalMediaDraft.Source)</dd>
                                    </div>
                                    <div>
                                        <dt>@MobileUiText.QueueMediaFileNameLabel</dt>
                                        <dd>@item.LocalMediaDraft.FileName</dd>
                                    </div>
                                    <div>
                                        <dt>@MobileUiText.QueueMediaContentTypeLabel</dt>
                                        <dd>@GetLocalMediaContentTypeText(item.LocalMediaDraft.ContentType)</dd>
                                    </div>
                                    <div>
                                        <dt>@MobileUiText.QueueMediaSelectedAtLabel</dt>
                                        <dd>@FormatCreatedAt(item.LocalMediaDraft.SelectedAtUtc)</dd>
                                    </div>
                                    <div>
                                        <dt>@MobileUiText.QueueMediaDraftStateLabel</dt>
                                        <dd>@MobileUiText.GetQueueMediaDraftStateText(item.LocalMediaDraft.HasLocalReadHandle)</dd>
                                    </div>
                                </dl>

                                @if (!item.LocalMediaDraft.HasLocalReadHandle)
                                {
                                    <p class="queue-restored-note">@MobileUiText.QueueRestoredMetadataOnlyNoteText</p>
                                    <p class="queue-repair-hint">@MobileUiText.QueueRepairHintText</p>
                                }
                            </section>
                        }

                        @if (item.LocalReportDraft is not null)
                        {
                            <section class="queue-report-draft">
                                <dl class="queue-item-meta">
                                    <div>
                                        <dt>@MobileUiText.QueueItemTypeLabel</dt>
                                        <dd>@MobileUiText.QueueItemTypeReportDraftText</dd>
                                    </div>
                                    <div>
                                        <dt>@MobileUiText.QueueReportDraftIdLabel</dt>
                                        <dd>@item.LocalReportDraft.DraftId</dd>
                                    </div>
                                    <div>
                                        <dt>@MobileUiText.QueueReportAttachmentCountLabel</dt>
                                        <dd>@item.LocalReportDraft.AttachmentCount</dd>
                                    </div>
                                    <div>
                                        <dt>@MobileUiText.QueueReportVideoAttachmentCountLabel</dt>
                                        <dd>@item.LocalReportDraft.VideoAttachmentCount</dd>
                                    </div>
                                </dl>

                                <p class="queue-report-note">@MobileUiText.QueueReportDraftLocalOnlyNoteText</p>
                            </section>
                        }

                        <dl class="queue-item-meta">
                            <div>
                                <dt>@MobileUiText.QueueCreatedAtLabel</dt>
                                <dd>@FormatCreatedAt(item.CreatedAtUtc)</dd>
                            </div>
                            <div>
                                <dt>@MobileUiText.QueueStatusLabel</dt>
                                <dd>@MobileUiText.GetPendingSyncStatusText(item.Status)</dd>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(item.LastActionText))
                            {
                                <div>
                                    <dt>@MobileUiText.QueueLastActionLabel</dt>
                                    <dd>@item.LastActionText</dd>
                                </div>
                            }
                        </dl>

                        <div class="queue-item-actions">
                            @if (item.LocalMediaDraft is not null && !item.LocalMediaDraft.HasLocalReadHandle)
                            {
                                <button type="button" class="btn btn-outline-primary" @onclick="() => RepairAsync(item.ItemId)">
                                    @MobileUiText.QueueRepairButton
                                </button>
                            }
                            <button type="button" class="btn btn-outline-secondary" @onclick="() => RetryAsync(item.ItemId)">
                                @MobileUiText.QueueRetryButton
                            </button>
                            <button type="button" class="btn btn-outline-danger" @onclick="() => RemoveAsync(item.ItemId)">
                                @MobileUiText.QueueRemoveButton
                            </button>
                        </div>
                    </article>
                }
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(ResultText))
        {
            <p class="@(ResultIsWarning ? "queue-result queue-result-warning" : "queue-result")">@ResultText</p>
        }
    </section>
}

@code {
    private IReadOnlyList<global::App.Mobile.Android.Outbox.PendingSyncItem> Items { get; set; } =
        Array.Empty<global::App.Mobile.Android.Outbox.PendingSyncItem>();

    private bool IsLoading { get; set; }

    private string ResultText { get; set; } = string.Empty;

    private bool ResultIsWarning { get; set; }

    private bool ShowQueueFoundation =>
        FeatureFlagReader.IsEnabled(global::App.Mobile.Android.Services.Stubs.StubFeatureFlagReader.QueueFoundationCardFlag);

    protected override async Task OnInitializedAsync()
    {
        NavigationState.SetCurrentView(global::App.Mobile.Android.Navigation.MobileViewId.Queue);

        if (!ShowQueueFoundation)
        {
            return;
        }

        await LoadItemsAsync();
    }

    private async Task RetryAsync(string itemId)
    {
        var result = await MobileOutboxService.RetryAsync(itemId);
        ResultText = result.Message;
        ResultIsWarning = !result.Applied;
        await LoadItemsAsync();
    }

    private async Task RepairAsync(string itemId)
    {
        var result = await MobileOutboxService.RepairLocalMediaDraftAsync(itemId);
        ResultText = result.Message;
        ResultIsWarning = !result.Applied;
        await LoadItemsAsync();
    }

    private async Task RemoveAsync(string itemId)
    {
        var result = await MobileOutboxService.RemoveAsync(itemId);
        ResultText = result.Message;
        ResultIsWarning = !result.Applied;
        await LoadItemsAsync();
    }

    private async Task LoadItemsAsync()
    {
        IsLoading = true;
        try
        {
            Items = await MobileOutboxService.GetItemsAsync();
        }
        finally
        {
            IsLoading = false;
        }
    }

    private static string FormatCreatedAt(DateTimeOffset createdAtUtc)
    {
        return createdAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss");
    }

    private static string GetLocalMediaContentTypeText(string? contentType)
    {
        return string.IsNullOrWhiteSpace(contentType)
            ? MobileUiText.UploadUnknownContentTypeText
            : contentType;
    }
}
